<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!--
    Presentation layer only. Game rules live in IronPipeline.Sim.
    Godot may rewrite parts of this file on first open; keep the Sim reference and the TFM.
    If the installed Godot .NET build requires a different TargetFramework, change it here
    AND in ../../Directory.Build.props so Sim and Game agree.
  -->
  <PropertyGroup>
    <!-- Literal on purpose: after Godot 4.7 headless import, $(IronPipelineTfm) resolved to net8.0 in CI (NU1201); file itself is not rewritten.
         Keep in sync with IronPipelineTfm in ../../Directory.Build.props. -->
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>IronPipeline.Game</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../IronPipeline.Sim/IronPipeline.Sim.csproj" />
  </ItemGroup>
</Project>
